{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campaniadelsur",
  "compatibility_date": "2026-07-28",
  // Las variables de Albor se configuran a mano en Cloudflare (panel del Worker), NUNCA en este
  // archivo ni en el codigo. Por defecto, un deploy borra las vars que existen en el panel pero no
  // estan declaradas en la config; keep_vars lo evita, asi cada deploy conserva las que ya estan
  // cargadas. (Los Secrets no se ven afectados por esto: un deploy nunca los borra.)
  "keep_vars": true,
  // Worker/proxy hacia la API de Albor (ver worker/index.js).
  "main": "worker/index.js",
  "assets": {
    // Sin cambios: el sitio estatico completo se sigue sirviendo desde la raiz del repo.
    "directory": ".",
    // Expone los assets al Worker como env.ASSETS. Hoy el Worker no los necesita (no hace fallback
    // programatico), pero deja el binding disponible sin alterar como se sirve el dashboard.
    "binding": "ASSETS",
    // Solo /api/* entra al Worker ANTES de buscar un archivo estatico. Todo el resto del sitio
    // (index.html, css/, js/, img/, los .xlsx) se sigue resolviendo como asset primero, exactamente
    // igual que antes de existir el Worker — la carga del dashboard no puede romperse por esto.
    // Es explicito a proposito: como "directory" es la raiz del repo, sin esta regla un archivo o
    // carpeta llamado "api" taparia la ruta del proxy.
    "run_worker_first": ["/api/*"]
  },
  // Autenticacion centralizada contra Albor (ver la clase AlborAuth en worker/index.js): una unica
  // instancia logica guarda el token y su vencimiento, para que todos los endpoints /api/albor/*
  // reutilicen el mismo mientras siga vigente en vez de hacer login en cada consulta.
  "durable_objects": {
    "bindings": [
      { "name": "ALBOR_AUTH", "class_name": "AlborAuth" }
    ]
  },
  // Almacenamiento SQLite para el Durable Object (new_sqlite_classes). El objeto solo guarda dos
  // claves —el token y su expiracion—, nunca credenciales ni datos de reportes.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AlborAuth"] }
  ],
  // Workers Logs: habilita los logs del Worker en el panel de Cloudflare, para poder leer los
  // mensajes de diagnostico de worker/index.js (ej. que variable de entorno falta) sin necesidad de
  // dejar un `wrangler tail` abierto. Esos mensajes nunca incluyen credenciales ni el token: solo
  // texto fijo, nombres de variables y status HTTP.
  // head_sampling_rate 1 = se registra el 100% de las invocaciones (sin muestreo).
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}